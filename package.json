{
  "name": "convlens",
  "version": "0.1.2",
  "description": "面向人工智能通识课的 CNN 演示与实操教学工具",
  "author": "SohriCarryU",
  "type": "module",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "npm run typecheck && vite build --config vite.config.ts",
    "desktop:dev": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --config electron-builder.config.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview --config vite.config.ts",
    "test:release": "node --test tests/release-security.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "vite": "5.4.14",
    "typescript": "5.7.3"
  },
  "devDependencies": {
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "electron": "latest",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.sohri.convlens",
    "productName": "ConvLens",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist/training-data/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "ConvLens-${version}-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "ConvLens-${version}-Portable-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "ConvLens-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.education"
    }
  }
}

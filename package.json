{
  "name": "convlens",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "npm run typecheck && vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview --config vite.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "vite": "5.4.14",
    "typescript": "5.7.3"
  },
  "devDependencies": {
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3"
  }
}
